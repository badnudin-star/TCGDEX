# Einheitliche Zeilenenden, damit Windows/Linux keine Phantom-Aenderungen melden
* text=auto

*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.properties text eol=lf
*.pro    text eol=lf
*.sh     text eol=lf
gradlew  text eol=lf
*.bat    text eol=crlf

# Binaerdateien nie umwandeln
*.jar    binary
*.png    binary
*.webp   binary
*.sqlite binary
*.ttf    binary
